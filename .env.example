# Copy to .env, then set the local passwords and Docker socket group.
AIRFLOW_UID=1000
DOCKER_GID=998
ETL_PROJECT_ROOT=/absolute/path/to/project
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
MINIO_ROOT_USER=etl_admin
MINIO_ROOT_PASSWORD=change-me
CLOUDBERRY_PASSWORD=change-me
CLICKHOUSE_USER=etl
CLICKHOUSE_PASSWORD=change-me

KINOPOISK_API_KEY=

# Optional: one message when the DAG run finally fails. Empty = disabled.
AIRFLOW_ALERT_EMAIL=
# Public URL used in email links; use the host accessible to the recipient.
AIRFLOW_PUBLIC_URL=http://localhost:18080
# SMTP Connection JSON, or leave empty and create smtp_alerts in the Airflow UI.
# For port 465: disable_ssl=false, disable_tls=true.
# For port 587: disable_ssl=true, disable_tls=false (STARTTLS).
# Use single quotes around JSON in .env to preserve password characters.
# AIRFLOW_CONN_SMTP_ALERTS='{"conn_type":"smtp","host":"smtp.example.com","port":465,"login":"sender@example.com","password":"app-password","extra":{"from_email":"sender@example.com","disable_ssl":false,"disable_tls":true,"timeout":30,"retry_limit":1}}'
AIRFLOW_CONN_SMTP_ALERTS=
